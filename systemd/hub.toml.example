## Hub config — copy to /etc/term-hub/hub.toml and edit.

## Public DNS name. Used by ACME and as the WebAuthn origin host.
domain         = "term.xyz.com"

## WebAuthn Relying Party id. Must be a registrable suffix of `domain`.
## Using "xyz.com" lets the credentials be reused across siblings of
## term.xyz.com. Set this to `domain` for the strictest scoping.
rp_id          = "xyz.com"

## Human-readable name shown by the authenticator UI.
rp_name        = "term"

## TLS mode:
##   "acme" — terminate TLS in the hub via Let's Encrypt (TLS-ALPN-01).
##            The same cert is reused for the agent listener.
##   "off"  — plain HTTP/TCP on both ports. ONLY for local dev or
##            behind a reverse proxy.
tls            = "acme"

## ACME contact email (required when tls = "acme").
acme_email     = "ops@xyz.com"

## Set to true to use the production Let's Encrypt directory. Start with
## false (staging) until you've confirmed the setup works.
acme_production = false

## Data + cache. credentials.json, secret.key, acme/ live here.
data_dir       = "/var/lib/term-hub"

## Browser-facing bind. Default "[::]:443" (acme) / "[::]:8080" (off).
# bind         = "[::]:443"

## Agent-facing bind. Agents dial this address. TLS (same ACME cert) when
## tls = "acme", plain TCP when tls = "off". Default "[::]:7700".
agent_bind     = "[::]:7700"

## One block per machine. The hub *waits* for an agent presenting this
## machine id + matching PSK to connect; until then the machine's tabs
## get a "service unavailable" response.
##
## Generate a fresh 32-byte PSK with:
##   head -c 32 /dev/urandom | base64
[[machines]]
id    = "alpha"
label = "alpha.lan"
psk   = "REPLACE_WITH_BASE64_32_RANDOM"

[[machines]]
id    = "wsl-laptop"
label = "WSL laptop"
psk   = "REPLACE_WITH_ANOTHER_BASE64_32_RANDOM"
